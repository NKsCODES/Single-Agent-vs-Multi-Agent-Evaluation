# Offline (default): no keys needed.
ARCHEVAL_LLM_PROVIDER=sim
ARCHEVAL_VECTOR_STORE=memory
ARCHEVAL_EMBEDDINGS=hashing

# Azure (Entra ID through DefaultAzureCredential: az login locally, managed identity in Azure).
# ARCHEVAL_LLM_PROVIDER=azure
# ARCHEVAL_AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com/
# ARCHEVAL_LARGE_DEPLOYMENT=large
# ARCHEVAL_SMALL_DEPLOYMENT=small
# ARCHEVAL_EMBEDDINGS=azure
# ARCHEVAL_EMBEDDING_DEPLOYMENT=embedding
# ARCHEVAL_EMBEDDING_DIMENSIONS=1536
# ARCHEVAL_VECTOR_STORE=cosmos
# ARCHEVAL_COSMOS_ENDPOINT=https://<name>.documents.azure.com:443/
# ARCHEVAL_CONTENT_SAFETY_ENDPOINT=https://<name>.cognitiveservices.azure.com/
# ARCHEVAL_APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Prices in USD per 1M tokens. Set them to your deployments' real prices before trusting costs.
# ARCHEVAL_PRICES='{"large":{"input_per_million":2.0,"output_per_million":8.0},"small":{"input_per_million":0.4,"output_per_million":1.6}}'

# Budgets shared by every architecture
# ARCHEVAL_LIMITS__SINGLE_MAX_ITERATIONS=6
# ARCHEVAL_LIMITS__MAX_WORKERS=4

# Optional API key for /v1 endpoints
# ARCHEVAL_API_KEY=change-me
